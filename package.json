{
  "name": "l2g-toolchain-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-module Playwright, axe-core, visual, local-file, quality, and security regression for the L2G Toolchain.",
  "scripts": {
    "test": "npm run check:all",
    "test:qa": "python modules/builder-merger/releases/v3.10.1/materialize.py && python modules/builder-merger/releases/v3.10.1/validate_v3_10_1.py && playwright test tests/playwright/runtime.spec.mjs tests/playwright/workshop-v79.spec.mjs tests/playwright/workshop-v791-strict-merge.spec.mjs tests/playwright/workshop-v791-ssp-route.spec.mjs tests/playwright/accessibility.spec.mjs tests/playwright/builder-merger-v3101-word-qa.spec.mjs tests/playwright/builder-merger-v3101-workshop-preservation.spec.mjs tests/playwright/builder-merger-v3101-rich-preservation.spec.mjs tests/playwright/ssp-v196-ux1.spec.mjs tests/playwright/ssp-v197-ux2.spec.mjs tests/playwright/ssp-v198-rg1.spec.mjs tests/playwright/ssp-v199-rg2.spec.mjs tests/playwright/ssp-v1910-ux3.spec.mjs tests/playwright/ssp-v1911-rg3.spec.mjs tests/playwright/ssp-v1912-compact-chrome.spec.mjs tests/playwright/ssp-v1913-dark-toolbar.spec.mjs tests/playwright/ssp-v1914-command-surface.spec.mjs tests/playwright/ssp-v1915-needs-attention-density.spec.mjs tests/playwright/ssp-v1916-review-workspace-density.spec.mjs tests/playwright/ssp-v1917-rg4-word-qa-consumer.spec.mjs tests/playwright/ssp-rg4-history-harness.spec.mjs --project=chromium",
    "test:unit": "python -m unittest discover -s quality/tests -p test_*.py",
    "test:e2e": "playwright test tests/playwright/integrated-suite-v06.spec.mjs --project=chromium",
    "test:visual": "python modules/builder-merger/releases/v3.10.1/materialize.py && playwright test tests/playwright/visual.spec.mjs tests/playwright/workshop-v791-visual.spec.mjs tests/playwright/builder-merger-v3101-visual.spec.mjs tests/playwright/ssp-v1913-dark-toolbar.spec.mjs tests/playwright/ssp-v1914-command-surface.spec.mjs tests/playwright/ssp-v1915-needs-attention-density.spec.mjs tests/playwright/ssp-v1916-review-workspace-density.spec.mjs tests/playwright/ssp-v1917-rg4-word-qa-consumer.spec.mjs --project=chromium",
    "test:a11y": "playwright test tests/playwright/accessibility.spec.mjs tests/playwright/integrated-suite-v06.spec.mjs --project=chromium --grep \"accessibility|Client|workbench\"",
    "test:files": "python -m unittest discover -s quality/tests -p test_*.py",
    "test:contracts": "python quality/scripts/quality_gate.py contracts",
    "test:offline": "python quality/scripts/quality_gate.py offline",
    "test:fuzz": "python -m unittest discover -s quality/tests -p test_*.py",
    "test:file": "python modules/builder-merger/releases/v3.10.1/materialize.py && playwright test tests/playwright/file-smoke.spec.mjs tests/playwright/workshop-v791-file-smoke.spec.mjs tests/playwright/builder-merger-v3101-file.spec.mjs tests/playwright/ssp-rg4-history-file-smoke.spec.mjs --project=chromium",
    "test:rg4-history": "playwright test tests/playwright/ssp-v1917-rg4-word-qa-consumer.spec.mjs tests/playwright/ssp-rg4-history-harness.spec.mjs --project=chromium",
    "test:rg4-merged-main": "playwright test tests/playwright/builder-merger-v3101-word-qa.spec.mjs tests/playwright/builder-merger-v3101-workshop-preservation.spec.mjs tests/playwright/builder-merger-v3101-rich-preservation.spec.mjs tests/playwright/workshop-v791-strict-merge.spec.mjs tests/playwright/workshop-v791-ssp-route.spec.mjs tests/playwright/ssp-v1917-rg4-word-qa-consumer.spec.mjs tests/playwright/ssp-rg4-history-harness.spec.mjs --project=chromium",
    "test:integrated-foundation": "npm test --prefix apps/integrated-suite && playwright test tests/playwright/integrated-suite-foundation-shell.spec.mjs tests/playwright/integrated-suite-foundation-project.spec.mjs tests/playwright/integrated-suite-foundation-accessibility.spec.mjs --project=chromium",
    "test:integrated-foundation:file": "npm test --prefix apps/integrated-suite && playwright test tests/playwright/integrated-suite-foundation-file.spec.mjs --project=chromium",
    "test:all": "playwright test --project=chromium",
    "check:html": "python quality/scripts/quality_gate.py html",
    "check:security": "python quality/scripts/quality_gate.py workflows",
    "check:privacy": "python quality/scripts/quality_gate.py privacy",
    "check:package": "python quality/scripts/quality_gate.py package",
    "check:all": "python quality/scripts/quality_gate.py all"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1"
  }
}
