+.wqa-shell{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}.wqa-span-12{grid-column:span 12}.wqa-span-8{grid-column:span 8}.wqa-span-6{grid-column:span 6}.wqa-span-4{grid-column:span 4}.wqa-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px}.wqa-flow div{border:1px solid var(--line);border-radius:13px;padding:10px;background:var(--panel2);font-size:12px;color:var(--muted)}.wqa-flow strong{display:block;color:var(--brand);margin-bottom:4px}.wqa-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.wqa-grid label{display:grid;gap:5px;font-size:12px;color:var(--muted)}.wqa-grid .full{grid-column:span 2}.wqa-grid input,.wqa-grid textarea,.wqa-grid select{min-width:0}.wqa-checklist{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:10px 0}.wqa-checkline{display:flex;align-items:flex-start;gap:9px;border:1px solid var(--line);border-radius:12px;padding:10px;background:var(--panel2);font-size:13px}.wqa-checkline input{width:auto;margin-top:3px}.wqa-checkline strong{display:block}.wqa-checkline span{display:block;color:var(--muted);font-size:12px}.wqa-results{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.wqa-metric{border:1px solid var(--line);border-radius:13px;background:var(--panel2);padding:10px}.wqa-metric span{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.wqa-metric strong{display:block;font-size:21px;margin-top:3px}.wqa-state-complete{color:var(--good)}.wqa-state-incomplete{color:var(--warn)}.wqa-state-blocked{color:var(--bad)}.wqa-table{min-width:1120px}.wqa-table td:nth-child(1){font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;white-space:nowrap}.wqa-result-pass{color:var(--good);font-weight:800}.wqa-result-fail{color:var(--bad);font-weight:800}.wqa-result-human{color:var(--warn);font-weight:800}.wqa-identity{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.wqa-identity div{border:1px solid var(--line);border-radius:12px;padding:9px;background:#050500;min-width:0}.wqa-identity span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase}.wqa-identity code{display:block;overflow-wrap:anywhere;margin-top:3px;font-size:11px}.wqa-warning{border-left:4px solid var(--warn);background:#211f00;color:#fff78a;border-radius:12px;padding:11px}.wqa-block{border-left:4px solid var(--bad);background:#260808;color:#ffd1d1;border-radius:12px;padding:11px}.wqa-pass{border-left:4px solid var(--good);background:#152000;color:#e8ffb0;border-radius:12px;padding:11px}.wqa-json{min-height:430px;max-height:620px}.wqa-local-label{border:1px dashed var(--line);border-radius:12px;padding:10px;color:var(--muted);font-size:12px}.wqa-inline{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.wqa-inline input{width:auto}.wqa-scope-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.wqa-scope-grid label{display:grid;gap:4px;color:var(--muted);font-size:12px}.wqa-print-only{display:none}.wqa-roadmap-current{border-left:5px solid var(--good)}
