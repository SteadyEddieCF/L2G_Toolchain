+.v3101-validation.trusted{border-left-color:var(--good)}.v3101-validation.legacy{border-left-color:var(--warn)}.v3101-validation.blocked{border-left-color:var(--bad)}
+.v3101-validation strong{display:block;font-size:15px;margin-bottom:4px}.v3101-validation code{overflow-wrap:anywhere}.v3101-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:8px}.v3101-grid div{border:1px solid var(--line);border-radius:10px;padding:8px;background:#050500}.v3101-grid span{display:block;color:var(--muted);font-size:11px;text-transform:uppercase}.v3101-grid b{display:block;margin-top:2px;overflow-wrap:anywhere}.v3101-note{margin-top:8px;color:var(--muted);white-space:pre-wrap}.v3101-badge{display:inline-block;padding:3px 8px;border-radius:999px;font-size:11px;font-weight:900;border:1px solid currentColor;margin-left:6px}
