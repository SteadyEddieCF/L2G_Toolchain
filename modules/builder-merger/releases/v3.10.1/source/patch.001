 *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;line-height:1.45}.app{max-width:1380px;margin:0 auto;padding:20px}.hero{border:1px solid var(--line);border-radius:22px;padding:24px;background:linear-gradient(135deg,#000000 0%,#080808 58%,#2b2900 100%);box-shadow:0 10px 32px rgba(255,242,0,.10)}.eyebrow{color:var(--brand);font-weight:800;text-transform:uppercase;letter-spacing:.12em;font-size:12px}.hero h1{margin:.2rem 0 .5rem;font-size:clamp(28px,4vw,44px);letter-spacing:-.03em}.hero p{margin:0;max-width:105ch;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px;margin-top:14px}.card{grid-column:span 12;border:1px solid var(--line);border-radius:18px;background:var(--panel);padding:16px}.span-4{grid-column:span 4}.span-6{grid-column:span 6}.card h2{margin:0 0 8px}.muted,.small{color:var(--muted);font-size:13px}.callout{border-left:4px solid var(--brand);background:#1f1d00;color:#fff78a;border-radius:12px;padding:12px;margin-top:12px}input[type=file]{display:block;margin:10px 0;padding:10px;border:1px dashed var(--line);border-radius:12px;width:100%;background:var(--panel2);color:var(--ink)}button{border:1px solid var(--line);background:var(--panel2);color:var(--ink);border-radius:12px;padding:10px 14px;cursor:pointer;font-weight:800}button.primary{background:var(--brand);border-color:var(--brand);color:#000000;box-shadow:0 0 14px rgba(255,242,0,.25)}button:disabled{opacity:.45;cursor:not-allowed}.btnrow{display:flex;gap:8px;flex-wrap:wrap}.status{margin-top:12px;padding:10px 12px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);color:var(--blue);white-space:pre-wrap}.status.good{color:var(--good);border-color:#7fbf00}.status.bad{color:var(--bad);border-color:#b91c1c}.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.kpi{border:1px solid var(--line);border-radius:14px;background:var(--panel2);padding:12px}.kpi div{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.06em}.kpi strong{font-size:24px}pre{white-space:pre-wrap;overflow:auto;max-height:460px;background:#000000;color:#fffde7;border:1px solid var(--line);border-radius:14px;padding:14px}table{width:100%;border-collapse:collapse;min-width:980px}th,td{border-bottom:1px solid var(--line);padding:8px;text-align:left;vertical-align:top;font-size:13px}th{position:sticky;top:0;background:#090900;color:#fff200}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:14px}code{background:var(--panel2);padding:2px 5px;border-radius:6px}.footer{color:var(--muted);font-size:12px;margin:16px 0 0}@media(max-width:1000px){.span-4,.span-6{grid-column:span 12}.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
