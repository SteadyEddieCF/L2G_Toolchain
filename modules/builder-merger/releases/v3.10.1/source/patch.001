 function wqaHumanCheck(){const h=wqaHumanReady();return wqaCheck('WQA-LAYOUT-HUMAN',h.ready?'pass':'needs-human-review',h.ready?'Locally asserted visual review confirmed headings, tables, pagination, page breaks, headers, footers, numbering, visible placeholder residue, and overall delivery usability.':'Required local layout review remains incomplete or its local reviewer labels are missing.',h.ready?['operator:visual-review','review:headings','review:tables','review:pagination','review:page-breaks','review:headers-footers','review:numbering','review:visible-placeholder-residue','review:delivery-usability']:['operator:visual-review-required']);}
 function wqaAggregate(checks){const a={state:'qa_incomplete',pass:0,fail:0,needs_human_review:0,not_applicable:0};for(const c of checks){if(c.result==='pass')a.pass++;else if(c.result==='fail')a.fail++;else if(c.result==='needs-human-review')a.needs_human_review++;else a.not_applicable++;}a.state=a.fail?'qa_blocked':(a.needs_human_review?'qa_incomplete':'qa_complete');return a;}
