 document.addEventListener('DOMContentLoaded',wqaInit);
 function wqaToggleTheme(){const light=document.body.classList.toggle('wqa-light-theme'),b=wqaEl('wordQaThemeBtn');if(b){b.textContent=light?'Dark theme':'Light theme';b.setAttribute('aria-pressed',light?'true':'false');}}
 document.addEventListener('DOMContentLoaded',()=>wqaEl('wordQaThemeBtn')?.addEventListener('click',wqaToggleTheme));
