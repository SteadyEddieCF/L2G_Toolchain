  sidecar.lineage.lineage_key=await wqaDigestObject({package_kind:sidecar.package_kind,package_version:sidecar.package_version,scope:sidecar.scope,document_version:sidecar.source.document_version,qa_profile:{id:sidecar.qa_profile.id,version:sidecar.qa_profile.version}});const sidObj=structuredClone(sidecar);delete sidObj.sidecar_id;delete sidObj.package_fingerprint;sidecar.sidecar_id='sha256:'+await wqaDigestObject(sidObj);const pkgObj=structuredClone(sidecar);delete pkgObj.package_fingerprint;sidecar.package_fingerprint=await wqaDigestObject(pkgObj);return sidecar;}
 function wqaRenderChecks(){const ins=state.wordQa.inspection;if(!ins)return;const checks=[...ins.checks.slice(0,4),wqaHumanCheck()],agg=wqaAggregate(checks);wqaEl('wordQaMetrics').innerHTML=[['State',agg.state],['Passed',agg.pass],['Failed',agg.fail],['Needs human',agg.needs_human_review],['Artifact bytes',ins.size_bytes]].map(([l,v])=>`<div class="wqa-metric"><span>${wqaEsc(l)}</span><strong class="${agg.state==='qa_complete'?'wqa-state-complete':agg.state==='qa_blocked'?'wqa-state-blocked':'wqa-state-incomplete'}">${wqaEsc(v)}</strong></div>`).join('');wqaEl('wordQaChecksTable').innerHTML=`<table class="wqa-table"><thead><tr><th>Check</th><th>Class</th><th>Severity</th><th>Result</th><th>Summary</th><th>Evidence</th></tr></thead><tbody>${checks.map(c=>`<tr><td>${wqaEsc(c.check_id)}</td><td>${wqaEsc(c.classification)}</td><td>${wqaEsc(c.severity)}</td><td class="${c.result==='pass'?'wqa-result-pass':c.result==='fail'?'wqa-result-fail':'wqa-result-human'}">${wqaEsc(c.result)}</td><td>${wqaEsc(c.summary)}</td><td>${c.evidence_refs.map(x=>`<code>${wqaEsc(x)}</code>`).join('<br>')}</td></tr>`).join('')}</tbody></table>`;const can=!!ins.manifest;wqaEl('wordQaPreviewBtn').disabled=!can;wqaEl('wordQaExportMessage').className=agg.state==='qa_blocked'?'wqa-block':agg.state==='qa_complete'?'wqa-pass':'wqa-warning';wqaEl('wordQaExportMessage').textContent=can?(agg.state==='qa_blocked'?'Blocking QA conditions are present. A qa_blocked sidecar may be exported when source identity is available.':agg.state==='qa_complete'?'All frozen checks currently pass. Generate the preview to calculate exact identities.':'Automated checks pass, but the required local human assertion remains incomplete.'):'A readable embedded SSP Word-export manifest is required before sidecar generation.';}
 function wqaRenderIdentity(){const i=state.wordQa.inspection;if(!i)return;const m=i.manifest||{},items=[['File name',i.file_name],['DOCX SHA-256',i.artifact_sha256],['Size bytes',i.size_bytes],['Manifest SHA-256',i.manifest_sha256||'Unavailable'],['SSP release',m.runtimeRelease||'Unavailable'],['Working schema',m.schema||'Unavailable'],['Document version',m.documentVersion||'Unavailable'],['Review-package ID',m.reviewPackageId||'Unavailable'],['Source SSP fingerprint',m.sourceFingerprint||'Unavailable'],['Review scope',m.reviewScope||'Unavailable'],['Requirement records',i.requirement_count],['Source reconciliation',i.source_reconciled?'Reconciled':'Not reconciled']];wqaEl('wordQaIdentity').innerHTML=items.map(([l,v])=>`<div><span>${wqaEsc(l)}</span><code>${wqaEsc(v)}</code></div>`).join('');}
 function wqaRenderPreview(sidecar){wqaEl('wordQaJsonPreview').textContent=JSON.stringify(sidecar,null,2);wqaEl('wordQaDownloadBtn').disabled=false;wqaEl('wordQaReportBtn').disabled=false;wqaEl('wordQaPrintBtn').disabled=false;}
 function wqaDownload(text,type,name){const blob=new Blob([text],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
-function wqaReport(s){return `# L2G Builder/Merger v3.10 SSP Final Word-QA Report\n\nGenerated: ${s.created_at}\n\n## Authority boundary\n\nThis report records final Word-QA evidence only. It does not determine source currency, readiness, compliance, assessment, certification, scoring, technical accuracy, evidence sufficiency, or client-release approval.\n\n## Artifact\n\n- File: ${s.artifact.file_name}\n- Size: ${s.artifact.size_bytes}\n- SHA-256: ${s.artifact.sha256}\n- Embedded manifest SHA-256: ${s.source.word_export_manifest_sha256}\n- Source fingerprint declared by SSP: ${s.source.source_ssp_fingerprint}\n- Review-package ID: ${s.source.review_package_id}\n\n## Result\n\n- Aggregate state: ${s.aggregate.state}\n- Pass: ${s.aggregate.pass}\n- Fail: ${s.aggregate.fail}\n- Needs human review: ${s.aggregate.needs_human_review}\n- Sidecar ID: ${s.sidecar_id}\n- Package fingerprint: ${s.package_fingerprint}\n- Lineage key: ${s.lineage.lineage_key}\n- Attempt: ${s.lineage.attempt_number}\n- Immediately preceding sidecar: ${s.lineage.supersedes_sidecar_id||'None'}\n\n## Frozen checks\n\n${s.checks.map(c=>`### ${c.check_id}\n- Classification: ${c.classification}\n- Severity: ${c.severity}\n- Result: ${c.result}\n- Summary: ${c.summary}\n- Evidence: ${c.evidence_refs.join('; ')}`).join('\n\n')}\n\n## Local assertion\n\n${s.operator_assertions.length?`Local reviewer ID: ${s.operator_assertions[0].local_id}\nDisplay name: ${s.operator_assertions[0].display_name}\nAsserted at: ${s.operator_assertions[0].asserted_at}\nLocally asserted: true\nAuthenticated: false\nDigital signature: false`:'No completed local human assertion is present.'}\n`;}
