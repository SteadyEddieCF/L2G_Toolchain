 async function wqaBuildSidecar(){const ins=state.wordQa.inspection;if(!ins||!ins.manifest)throw Error('A readable embedded SSP Word-export manifest is required before sidecar generation.');const attempt=Number(wqaEl('wordQaAttempt').value||1),sup=(wqaEl('wordQaSupersedes').value||'').trim()||null,created=(wqaEl('wordQaCreatedAt').value||'').trim()||wqaUtcNow();if(!Number.isInteger(attempt)||attempt<1)throw Error('Attempt number must be a positive integer.');if(!wqaUtcValid(created))throw Error('Created at must use UTC RFC 3339 seconds form.');if(attempt===1&&sup!==null)throw Error('Attempt 1 must not declare a preceding sidecar ID.');if(attempt>1&&!/^sha256:[0-9a-f]{64}$/.test(sup||''))throw Error('Attempt 2 or higher requires a valid immediately preceding sidecar ID.');const manifest=ins.manifest,schemaMatch=String(manifest.schema||'').match(/^cmmc-l2-ssp-modern-v(\d+\.\d+\.\d+)$/),checks=[...ins.checks.slice(0,4),wqaHumanCheck()],aggregate=wqaAggregate(checks),human=wqaHumanReady(),assertions=[];if(human.ready){const asserted=(wqaEl('wordQaAssertedAt').value||'').trim()||created;if(!wqaUtcValid(asserted))throw Error('Asserted at must use UTC RFC 3339 seconds form.');if(Date.parse(asserted)>Date.parse(created))throw Error('Asserted at must be less than or equal to Created at.');assertions.push({check_id:'WQA-LAYOUT-HUMAN',local_id:human.id,display_name:human.name,asserted_at:asserted,locally_asserted:true,authenticated:false,digital_signature:false});}
