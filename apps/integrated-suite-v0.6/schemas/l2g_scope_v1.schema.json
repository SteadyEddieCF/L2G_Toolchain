{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2g.local/schemas/l2g_scope_v1.schema.json",
  "title": "L2G Scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind","schema_version","scope_id","created_at","updated_at","revision","boundaries","systems","assets","providers","services","locations","enclaves","data_flows","assumptions","unknowns","dependencies","diagrams","decisions","candidates","import_receipts","projection_policy"],
  "properties": {
    "schema_kind": {"const": "l2g_scope_v1"},
    "schema_version": {"const": "1.0"},
    "scope_id": {"type": "string", "pattern": "^scope_"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 0},
    "boundaries": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/boundary"}},
    "systems": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/object"}},
    "assets": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/object"}},
    "providers": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/object"}},
    "services": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/object"}},
    "locations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/object"}},
    "enclaves": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/object"}},
    "data_flows": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/base"}},
    "assumptions": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/base"}},
    "unknowns": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/base"}},
    "dependencies": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/base"}},
    "diagrams": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/base"}},
    "decisions": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/base"}},
    "candidates": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/base"}},
    "import_receipts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/base"}},
    "projection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_visible_values","search_index_persistence","client_include_advisor_analysis","client_include_hidden_counts"],
      "properties": {
        "client_visible_values": {"const": ["client-safe","approved-for-client-presentation"]},
        "search_index_persistence": {"const": "none"},
        "client_include_advisor_analysis": {"const": false},
        "client_include_hidden_counts": {"const": false}
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_kind","source_refs","source_label","asserted_at","asserted_by"],
      "properties": {
        "origin_kind": {"enum": ["scope-local","engagement","evidence","pre-engagement","interview-sessions","compatibility-import","migration"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/versionedRef"}},
        "source_label": {"type": "string", "maxLength": 500},
        "asserted_at": {"type": "string", "format": "date-time"},
        "asserted_by": {"enum": ["advisor","client","reviewer","migration","system"]}
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}}
    },
    "base": {
      "type": "object",
      "required": ["id","version","label","description","lifecycle","operational_state","review_state","visibility","currency_state","provenance","created_at","updated_at","created_by_profile","updated_by_profile","supersedes_id","superseded_by_id","tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^scope-"},
        "version": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "maxLength": 500},
        "description": {"type": "string", "maxLength": 100000},
        "lifecycle": {"enum": ["draft","active","inactive","archived","superseded"]},
        "operational_state": {"enum": ["not-started","in-progress","blocked","waiting","complete","cancelled","not-applicable"]},
        "review_state": {"enum": ["not-reviewed","pending","in-review","reviewed","changes-requested","rejected","closed"]},
        "visibility": {"enum": ["advisor-only","client-safe","approved-for-client-presentation"]},
        "currency_state": {"enum": ["current","stale","conflicted","unverified","superseded"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "created_by_profile": {"enum": ["advisor","client","reviewer","system-migration"]},
        "updated_by_profile": {"enum": ["advisor","client","reviewer","system-migration"]},
        "supersedes_id": {"type": ["string","null"]},
        "superseded_by_id": {"type": ["string","null"]},
        "tags": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 200}}
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["asset_category","scope_disposition","boundary_relationship","implementation_location","responsibility_model","decision_refs"],
      "properties": {
        "asset_category": {"enum": ["cui-asset","security-protection-asset","contractor-risk-managed-asset","specialized-asset","out-of-scope-asset","unclassified"]},
        "scope_disposition": {"enum": ["proposed-in-scope","accepted-in-scope","proposed-out-of-scope","accepted-out-of-scope","unknown","disputed","deferred","superseded"]},
        "boundary_relationship": {"enum": ["inside","outside","crosses-boundary","supports-boundary","inherits-into-boundary","shared","unknown","not-applicable"]},
        "implementation_location": {"enum": ["client-managed","provider-managed","co-managed","inherited","external","unknown","not-applicable"]},
        "responsibility_model": {"enum": ["client","provider","shared","inherited","unassigned","disputed","not-applicable"]},
        "decision_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "object": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"$ref": "#/$defs/dimensions"},
        {
          "type": "object",
          "required": ["family","object_kind","related_refs","owner_org_ref","provider_ref","identifier_summary","function_summary","responsibility_summary","client_label","plain_language_summary"],
          "properties": {
            "family": {"enum": ["system","asset","provider","service","location","enclave"]},
            "object_kind": {"type": "string", "maxLength": 100},
            "related_refs": {"type": "array", "maxItems": 5000, "items": {"type": "string"}},
            "owner_org_ref": {"type": ["string","null"]},
            "provider_ref": {"type": ["string","null"]},
            "identifier_summary": {"type": "string", "maxLength": 100000},
            "function_summary": {"type": "string", "maxLength": 100000},
            "responsibility_summary": {"type": "string", "maxLength": 100000},
            "client_label": {"type": "string", "maxLength": 500},
            "plain_language_summary": {"type": "string", "maxLength": 100000}
          }
        }
      ]
    },
    "boundary": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["boundary_kind","purpose","scope_disposition","included_refs","excluded_refs","entry_exit_point_refs","location_refs","enclave_refs","decision_refs","assumption_refs","unknown_refs","diagram_refs","client_label","plain_language_summary"],
          "properties": {
            "boundary_kind": {"enum": ["cui-environment","security-protection","corporate-support","development-test","provider-hosted","other"]},
            "purpose": {"type": "string", "maxLength": 100000},
            "scope_disposition": {"enum": ["proposed-in-scope","accepted-in-scope","proposed-out-of-scope","accepted-out-of-scope","unknown","disputed","deferred","superseded"]},
            "included_refs": {"type": "array", "items": {"type": "string"}},
            "excluded_refs": {"type": "array", "items": {"type": "string"}},
            "entry_exit_point_refs": {"type": "array", "items": {"type": "string"}},
            "location_refs": {"type": "array", "items": {"type": "string"}},
            "enclave_refs": {"type": "array", "items": {"type": "string"}},
            "decision_refs": {"type": "array", "items": {"type": "string"}},
            "assumption_refs": {"type": "array", "items": {"type": "string"}},
            "unknown_refs": {"type": "array", "items": {"type": "string"}},
            "diagram_refs": {"type": "array", "items": {"type": "string"}},
            "client_label": {"type": "string", "maxLength": 500},
            "plain_language_summary": {"type": "string", "maxLength": 100000}
          }
        }
      ]
    }
  }
}
