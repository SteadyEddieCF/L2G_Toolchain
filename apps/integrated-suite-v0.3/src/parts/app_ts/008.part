        async persistRecovery() { if (!this.protection.baseKey) return; const result = await L2G.encryptProject(this.store.document, this.protection.baseKey, "browser-recovery"); this.protection.recoveryKey = result.key; this.protection.recoverySalt = result.salt; await this.recovery.save(result.bytes); this.saveState = "Saved in encrypted browser recovery; project file not necessarily written"; this.render(); }
        async lock() { if (!this.protection.baseKey) return; if (!confirm("Lock this project? The page will reload and encrypted recovery will require the passphrase.")) return; try { await this.persistRecovery(); this.protection = {}; location.reload(); } catch (error) { this.toast(`Lock failed because encrypted recovery could not be saved: ${L2G.errorMessage(error)}`, "error"); } }
        updateIdentity(name, value) {
            const advisor = this.store.document.state.profile === "advisor" && !this.readOnly; if (!advisor) return;
            const allowed = new Set(["engagement_name", "client_name", "system_name", "delivery_context", "objectives", "target_level", "phase", "start_date", "target_end_date", "information_label", "visibility"]); if (!allowed.has(name)) return;
            this.store.execute(`Update engagement ${name.replace(/_/g, " ")}`, "engagement", this.store.document.state.engagement.engagement_id, state => { state.engagement.identity[name] = L2G.sanitizePlainText(value, name === "objectives" ? 8000 : 200); state.engagement.identity.updated_at = L2G.nowIso(); L2G.validateEngagementDomain(state.engagement); });
        }
        addRecordDialog(type) {
            if (this.store.document.state.profile !== "advisor") return;
            if (type === "candidate") return this.candidateCreateDialog();
            const labels = { participant: "Participant", organization: "Organization", assumption: "Assumption", constraint: "Constraint", decision: "Decision", "open-question": "Open question", milestone: "Milestone", blocker: "Blocker" };
            this.dialog(`Add synthetic ${labels[type] ?? "record"}`, `<form id="record-form" class="dialog-form"><label class="field"><span>${type === "participant" || type === "organization" ? "Name" : "Title"}</span><input id="r-title" required maxlength="200"></label>${type === "participant" ? '<label class="field"><span>Role</span><input id="r-role" maxlength="200"></label>' : ""}${type === "organization" ? '<label class="field"><span>Relationship</span><select id="r-relationship"><option>other</option><option>client</option><option>advisor</option><option>MSP</option><option>CSP</option><option>provider</option><option>assessor</option></select></label>' : ""}${!["participant", "organization"].includes(type) ? '<label class="field"><span>Detail</span><textarea id="r-detail" maxlength="8000"></textarea></label>' : ""}${type === "milestone" ? '<label class="field"><span>Target date</span><input id="r-date" type="date"></label>' : ""}${type === "blocker" ? '<label class="field"><span>Severity</span><select id="r-severity"><option>medium</option><option>low</option><option>high</option><option>critical</option></select></label>' : ""}<label class="field"><span>Visibility</span><select id="r-vis"><option value="advisor-only">Advisor-only</option><option value="client-safe">Client-safe</option><option value="approved-for-client-presentation">Approved for client presentation</option></select></label><div class="dialog-actions"><button type="button" data-cancel class="secondary-button">Cancel</button><button type="submit" class="primary-button">Add</button></div></form>`);
            this.by("record-form").onsubmit = event => { event.preventDefault(); const title = L2G.sanitizePlainText(this.by("r-title").value, 200); if (!title.trim()) return; const detail = document.getElementById("r-detail") ? L2G.sanitizePlainText(this.by("r-detail").value, 8000) : ""; const visibility = this.by("r-vis").value; const now = L2G.nowIso(); this.store.execute(`Add ${type} “${title}”`, type, "new", state => { const d = state.engagement; const provenance = L2G.manualProvenance(); const base = { title, detail, visibility, provenance, related_refs: [], created_at: now, updated_at: now }; if (type === "participant") d.participants.push({ participant_id: L2G.newId("participant"), name: title, role: L2G.sanitizePlainText(this.by("r-role").value, 200), organization_id: "", contact_reference: "", participation_state: "active", visibility, provenance, created_at: now, updated_at: now }); else if (type === "organization") d.organizations.push({ organization_id: L2G.newId("organization"), name: title, relationship: this.by("r-relationship").value, status: "active", visibility, provenance, created_at: now, updated_at: now }); else if (type === "assumption") d.assumptions.push({ assumption_id: L2G.newId("assumption"), ...base, state: "open" }); else if (type === "constraint") d.constraints.push({ constraint_id: L2G.newId("constraint"), ...base, state: "active" }); else if (type === "decision") d.decisions.push({ decision_id: L2G.newId("decision"), ...base, state: "proposed", rationale: "" }); else if (type === "open-question") d.open_questions.push({ question_id: L2G.newId("question"), ...base, state: "open", answer: "" }); else if (type === "milestone") d.milestones.push({ milestone_id: L2G.newId("milestone"), ...base, target_date: this.by("r-date").value, owner_label: "Advisor", workstream: "Engagement", operational_state: "planned" }); else if (type === "blocker") d.blockers.push({ blocker_id: L2G.newId("blocker"), ...base, severity: this.by("r-severity").value, operational_state: "open", owner_label: "Advisor" }); L2G.validateEngagementDomain(d); }); this.closeDialog(); };
            this.by("record-form").querySelector("[data-cancel]").onclick = () => this.closeDialog();
        }
        candidateCreateDialog() {
