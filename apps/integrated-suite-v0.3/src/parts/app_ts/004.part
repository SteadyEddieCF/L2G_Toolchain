            return `<section class="workbench"><div class="list-card"><div class="section-title"><div><h2>Participants</h2><p>${participants.length} visible active participant${participants.length === 1 ? "" : "s"}.</p></div>${advisor ? '<button class="secondary-button" data-add-type="participant">Add participant</button>' : ""}</div>${this.cards(participants, item => `<h3>${L2G.escapeHtml(item.name)}</h3><p>${L2G.escapeHtml(item.role || "No role")}</p><div class="chip-row"><span class="chip">${L2G.escapeHtml(item.participation_state)}</span><span class="chip">${L2G.escapeHtml(item.visibility)}</span></div>`, advisor ? item => `<button class="text-button" data-deactivate-participant="${item.participant_id}">Deactivate</button>` : null)}</div><div class="list-card"><div class="section-title"><div><h2>Organizations</h2><p>${orgs.length} visible active organization${orgs.length === 1 ? "" : "s"}.</p></div>${advisor ? '<button class="secondary-button" data-add-type="organization">Add organization</button>' : ""}</div>${this.cards(orgs, item => `<h3>${L2G.escapeHtml(item.name)}</h3><p>${L2G.escapeHtml(item.relationship)}</p><div class="chip-row"><span class="chip">${L2G.escapeHtml(item.status)}</span><span class="chip">${L2G.escapeHtml(item.visibility)}</span></div>`, advisor ? item => `<button class="text-button" data-deactivate-org="${item.organization_id}">Deactivate</button>` : null)}</div></section>`;
        }
        dualLists(leftTitle, leftItems, rightTitle, rightItems, advisor, leftType, rightType) {
            return `<section class="workbench"><div class="list-card"><div class="section-title"><h2>${leftTitle}</h2>${advisor ? `<button class="secondary-button" data-add-type="${leftType}">Add</button>` : ""}</div>${this.genericCards(leftItems)}</div><div class="list-card"><div class="section-title"><h2>${rightTitle}</h2>${advisor ? `<button class="secondary-button" data-add-type="${rightType}">Add</button>` : ""}</div>${this.genericCards(rightItems)}</div></section>`;
        }
        candidates(advisor) {
            const profile = this.store.document.state.profile;
            if (profile === "client") return '<div class="empty-state large"><h2>Candidate review is not part of Client View</h2><p>Candidate titles, counts, provenance, confidence, and rationale are filtered before rendering.</p></div>';
            const items = this.store.document.state.engagement.candidates.filter(item => !this.searchTerm || `${item.source_kind} ${JSON.stringify(item.proposed_fields)}`.toLowerCase().includes(this.searchTerm.toLowerCase()));
            return `<div class="list-card"><div class="section-title"><div><h2>Engagement candidates</h2><p>Creating a candidate does not modify accepted Engagement state.</p></div>${advisor ? '<button class="secondary-button" data-add-type="candidate">Add candidate</button>' : ""}</div>${items.length ? `<div class="record-list">${items.map(item => `<article class="review-card" data-testid="candidate-card"><div><p class="eyebrow">${L2G.escapeHtml(item.source_kind)} → ${L2G.escapeHtml(item.target_type)}</p><h3>${L2G.escapeHtml(item.candidate_id)}</h3><pre>${L2G.escapeHtml(JSON.stringify(item.proposed_fields, null, 2))}</pre><div class="chip-row"><span class="chip">${L2G.escapeHtml(item.state)}</span><span class="chip">${L2G.escapeHtml(item.provenance.confidence)}</span></div>${item.rationale ? `<p>${L2G.escapeHtml(item.rationale)}</p>` : ""}</div>${advisor && item.state === "candidate" ? `<div class="review-actions"><button class="primary-button" data-candidate-action="accept" data-id="${item.candidate_id}">Accept</button><button class="secondary-button" data-candidate-action="modify" data-id="${item.candidate_id}">Modify</button><button class="secondary-button" data-candidate-action="reject" data-id="${item.candidate_id}">Reject</button><button class="text-button" data-candidate-action="supersede" data-id="${item.candidate_id}">Supersede</button></div>` : ""}</article>`).join("")}</div>` : '<div class="empty-state"><h3>No visible candidates</h3><p>Imported or proposed engagement metadata appears here for explicit review.</p></div>'}</div>`;
        }
        projectionCard(projection) {
            const workspace = WORKSPACES.find(item => item.id === projection.workspace);
            return `<section class="projection-card" data-testid="engagement-projection"><div class="section-title"><div><p class="eyebrow">Read-only Engagement projection</p><h2>${L2G.escapeHtml(projection.identity.engagement_name)}</h2><p>${L2G.escapeHtml(workspace?.description ?? "")}</p></div><span class="chip">frozen projection</span></div><div class="projection-grid"><div><strong>Phase</strong><span>${L2G.escapeHtml(projection.identity.phase)}</span></div><div><strong>Participants</strong><span>${projection.participants.length}</span></div><div><strong>Open questions</strong><span>${projection.open_questions.length}</span></div><div><strong>Milestones</strong><span>${projection.milestones.length}</span></div><div><strong>Blockers</strong><span>${projection.blockers.length}</span></div><div><strong>Source records</strong><span>${projection.source_record_ids.length}</span></div></div><h3>Factual next work</h3><ul class="compact-list">${projection.next_work.slice(0, 5).map(item => `<li><strong>${L2G.escapeHtml(item.title)}</strong><span>${L2G.escapeHtml(item.detail)}</span></li>`).join("")}</ul><div class="notice"><strong>Authority boundary</strong><p>This workspace cannot directly change Engagement records. Return to Pre-Engagement or create a review proposal.</p></div></section>`;
        }
        reviews(advisor, projection) {
            const doc = this.store.document;
            const candidateSummary = this.store.document.state.profile === "client" ? "" : `<div class="notice"><strong>Candidate decisions</strong><p>${doc.state.engagement.candidates.filter(item => item.state !== "candidate").length} decided candidate records remain in immutable history.</p></div>`;
