            return `<section class="workbench"><div class="list-card"><h2>Transition inbox</h2>${candidateSummary}<div class="record-list">${doc.state.reviews_actions.examples.map(item => `<article class="review-card"><div><p class="eyebrow">${L2G.escapeHtml(item.source_domain)} → ${L2G.escapeHtml(item.target_domain)}</p><h3>${L2G.escapeHtml(item.title)}</h3><p>${L2G.escapeHtml(item.rationale)}</p><div class="chip-row"><span class="chip">${item.lifecycle}</span><span class="chip">${item.review_state}</span><span class="chip">${item.operational_state}</span></div></div>${advisor ? `<div class="review-actions"><button class="primary-button" data-review="approve" data-id="${item.id}">Approve</button><button class="secondary-button" data-review="request" data-id="${item.id}">Request changes</button></div>` : ""}</article>`).join("")}</div></div><div class="list-card"><h2>Recent history</h2><ol class="history-list">${[...doc.history].reverse().slice(0, 20).map(event => `<li><time>${L2G.escapeHtml(new Date(event.timestamp).toLocaleString())}</time><strong>${L2G.escapeHtml(event.summary)}</strong><span>${L2G.escapeHtml(event.profile)} · ${L2G.escapeHtml(event.action)}</span></li>`).join("")}</ol>${doc.checkpoints.length ? `<h3>Checkpoints</h3>${[...doc.checkpoints].reverse().map(checkpoint => `<article class="record-card"><div><strong>${L2G.escapeHtml(checkpoint.name)}</strong><p>${L2G.escapeHtml(new Date(checkpoint.created_at).toLocaleString())}</p></div>${advisor ? `<button class="secondary-button" data-restore="${checkpoint.checkpoint_id}">Restore</button>` : ""}</article>`).join("")}` : ""}</div></section>`;
        }
        deliverables() {
            const registry = window.__L2G_CONTRACT_REGISTRY__;
            return `<section><div class="notice"><strong>Read-only compatibility catalog</strong><p>v0.3 does not migrate or mutate legacy contracts and does not generate deliverables.</p></div><div class="table-wrap" tabindex="0"><table><caption>Current contract registry ${L2G.escapeHtml(registry.registry_version)}</caption><thead><tr><th>Package kind</th><th>Version</th><th>Producer</th><th>Stability</th></tr></thead><tbody>${registry.contracts.map(contract => `<tr><td><code>${L2G.escapeHtml(String(contract.package_kind ?? ""))}</code></td><td>${L2G.escapeHtml(String(contract.version ?? ""))}</td><td>${L2G.escapeHtml(String(contract.producer ?? ""))}</td><td><span class="chip">${L2G.escapeHtml(String(contract.stability ?? ""))}</span></td></tr>`).join("")}</tbody></table></div></section>`;
        }
        inspector(projection, protectedSession) {
            const clientSafe = this.store.document.state.profile === "client";
            if (clientSafe) return "";
            const domain = this.store.document.state.engagement;
            return `<div class="prose"><p><strong>Project ID</strong></p><code class="hash">${L2G.escapeHtml(this.store.document.manifest.project_id)}</code><p><strong>Engagement ID</strong></p><code class="hash">${L2G.escapeHtml(domain.engagement_id)}</code><p><strong>Protection</strong></p><p>${protectedSession ? "A non-extractable session key is active. Portable saves and browser recovery are encrypted." : "No passphrase-derived key is active. Browser recovery is disabled."}</p><p><strong>Projection</strong></p><p>${projection.source_record_ids.length} profile-visible source records. Projections are deep-cloned and recursively frozen.</p><p><strong>Candidate authority</strong></p><p>${domain.candidates.filter(item => item.state === "candidate").length} awaiting review. Candidate creation never mutates accepted state.</p><p><strong>Data boundary</strong></p><p>Synthetic-only. Client data, FCI, and CUI remain unauthorized.</p></div>`;
        }
        input(label, name, value, disabled, type = "text") { return `<label class="field"><span>${L2G.escapeHtml(label)}</span><input data-identity="${name}" type="${type}" value="${L2G.escapeAttr(value)}" ${disabled} maxlength="${type === "date" ? 10 : 200}"></label>`; }
        select(label, name, value, options, disabled) { return `<label class="field"><span>${L2G.escapeHtml(label)}</span><select data-identity="${name}" ${disabled}>${options.map(item => `<option value="${L2G.escapeAttr(item)}" ${item === value ? "selected" : ""}>${L2G.escapeHtml(item)}</option>`).join("")}</select></label>`; }
        filter(items, profile) { return items.filter(item => L2G.visibilityAllows(item.visibility, profile)).filter(item => !this.searchTerm || `${item.title} ${item.detail}`.toLowerCase().includes(this.searchTerm.toLowerCase())); }
        cards(items, content, actions) { return items.length ? `<div class="record-list">${items.map(item => `<article class="record-card"><div>${content(item)}</div>${actions ? `<div class="record-meta">${actions(item)}</div>` : ""}</article>`).join("")}</div>` : '<div class="empty-state"><h3>No visible records</h3><p>Add a synthetic record or change the presentation profile.</p></div>'; }
        genericCards(items) { return this.cards(items, item => `<h3>${L2G.escapeHtml(item.title)}</h3><p>${L2G.escapeHtml(item.detail)}</p><div class="chip-row"><span class="chip">${L2G.escapeHtml(item.state ?? item.operational_state ?? "")}</span><span class="chip">${L2G.escapeHtml(item.visibility)}</span></div>`, null); }
        attach() {
            this.by("rail-toggle").onclick = () => { this.store.document.state.rail_collapsed = !this.store.document.state.rail_collapsed; this.render(); };
            this.by("undo").onclick = () => this.store.undo(); this.by("redo").onclick = () => this.store.redo();
            this.by("profile-select").onchange = event => { this.store.document.state.profile = event.target.value; this.store.document.state.inspector_open = false; this.searchTerm = ""; this.render(); };
            this.by("search-input").onchange = event => { this.searchTerm = L2G.sanitizePlainText(event.target.value, 200); this.render(); };
