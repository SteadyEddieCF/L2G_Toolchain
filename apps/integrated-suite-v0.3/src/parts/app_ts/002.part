          <label class="search-control"><span class="sr-only">Search visible engagement records</span><input id="search-input" type="search" value="${L2G.escapeAttr(this.searchTerm)}" placeholder="Search visible records" aria-label="Search visible engagement records"></label>
          <div class="top-actions">
            <button id="undo" class="icon-button" ${this.store.canUndo && advisor ? "" : "disabled"} aria-label="Undo${this.store.undoDescription ? ` ${L2G.escapeAttr(this.store.undoDescription)}` : ""}">↶</button>
            <button id="redo" class="icon-button" ${this.store.canRedo && advisor ? "" : "disabled"} aria-label="Redo${this.store.redoDescription ? ` ${L2G.escapeAttr(this.store.redoDescription)}` : ""}">↷</button>
            <label class="profile-control"><span class="sr-only">Presentation profile</span><select id="profile-select" aria-label="Presentation profile">${["advisor", "client", "reviewer"].map(item => `<option value="${item}" ${item === profile ? "selected" : ""}>${item[0].toUpperCase() + item.slice(1)}</option>`).join("")}</select></label>
            <button id="help" class="icon-button" aria-label="Open help">?</button>
            <button id="overflow" class="icon-button" aria-label="Open project actions" aria-haspopup="menu">⋯</button>
          </div>
        </header>
        <div class="profile-banner" role="status"><strong>${profileLabel} View</strong> · Presentation profile only—not a security boundary.${reviewer ? " Direct Engagement editing is read-only." : ""}${client ? " External distribution still requires a curated client-safe export." : ""}</div>
        <div class="body-grid">
          <nav class="nav-rail ${state.rail_collapsed ? "collapsed" : ""}" aria-label="Primary workspaces"><div class="rail-items">${WORKSPACES.map(item => `<button class="nav-item ${item.id === state.active_workspace ? "active" : ""}" data-workspace="${item.id}" aria-current="${item.id === state.active_workspace ? "page" : "false"}"><span class="nav-icon">${item.icon}</span><span class="nav-label">${L2G.escapeHtml(item.label)}</span></button>`).join("")}</div><button id="about" class="nav-item rail-bottom"><span class="nav-icon">ⓘ</span><span class="nav-label">About</span></button></nav>
          <main id="workspace-main" class="workspace" tabindex="-1"><header class="workspace-header"><div><p class="eyebrow">${profileLabel} View · Synthetic-only v0.3</p><h1>${L2G.escapeHtml(workspace.label)}</h1><p>${L2G.escapeHtml(workspace.description)}</p></div><div class="workspace-actions">${workspace.id === "pre-engagement" && advisor ? '<button id="add-record" class="primary-button">Add record</button>' : ""}${client ? "" : '<button id="context" class="secondary-button">Context</button>'}</div></header>${this.workspace(workspace.id, advisor, projection)}</main>
          <aside class="inspector ${state.inspector_open && !client ? "open" : ""}" aria-label="Context inspector" aria-hidden="${!state.inspector_open || client}" ${state.inspector_open && !client ? "" : "inert"}><div class="inspector-header"><strong>Engagement inspector</strong><button id="close-inspector" class="icon-button" aria-label="Close inspector">×</button></div>${this.inspector(projection, protectedSession)}</aside>
        </div>
        <div id="toast-region" class="toast-region" aria-live="polite"></div>
        <input id="open-input" type="file" accept=".l2g,application/zip" hidden>
        <div id="menu" class="menu" role="menu" hidden>
          <button role="menuitem" data-action="new">New project</button><button role="menuitem" data-action="open">Open .l2g</button><button role="menuitem" data-action="save">Save encrypted project</button><button role="menuitem" data-action="backup">Create encrypted backup</button><button role="menuitem" data-action="checkpoint">Create checkpoint</button><button role="menuitem" data-action="lock" ${protectedSession ? "" : "disabled"}>Lock project</button><button role="menuitem" data-action="clear-recovery">Clear browser recovery</button>
        </div>
        <dialog id="dialog" aria-labelledby="dialog-title"><div id="dialog-content"></div></dialog>
      </div>`;
            this.attach();
        }
        workspace(id, advisor, projection) {
            if (id === "overview") return this.overview(projection);
            if (id === "pre-engagement") return this.preEngagement(advisor, projection);
            if (id === "reviews-actions") return this.reviews(advisor, projection);
            if (id === "deliverables") return `${this.projectionCard(projection)}${this.deliverables()}`;
            return this.projectionCard(projection);
        }
        overview(projection) {
            const domain = this.store.document.state.engagement;
            const next = projection.next_work.slice(0, 5);
            const candidateCount = this.store.document.state.profile === "client" ? null : domain.candidates.filter(item => item.state === "candidate").length;
            return `<section class="dashboard">
              <article class="stage-card wide"><p class="eyebrow">Engagement phase</p><h2>${L2G.escapeHtml(projection.identity.phase)}</h2><p>${L2G.escapeHtml(projection.identity.delivery_context || "No delivery context recorded.")}</p>${this.migrationSource ? `<div class="notice"><strong>Migrated project</strong><p>Engagement data was deterministically migrated from ${L2G.escapeHtml(this.migrationSource)} without inferring downstream authority.</p></div>` : ""}</article>
              <article><p class="eyebrow">People</p><div class="metric">${projection.participants.length}</div><p>Visible active participants</p></article>
              <article><p class="eyebrow">Organizations</p><div class="metric">${projection.organizations.length}</div><p>Visible active organizations</p></article>
              <article><p class="eyebrow">Open questions</p><div class="metric">${projection.open_questions.length}</div><p>Visible factual questions</p></article>
