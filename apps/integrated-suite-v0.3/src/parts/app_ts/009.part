            this.dialog("Add synthetic engagement candidate", `<form id="candidate-form" class="dialog-form"><label class="field"><span>Target</span><select id="c-target"><option value="identity">Identity</option><option value="milestone">Milestone</option><option value="blocker">Blocker</option></select></label><label class="field"><span>Field</span><input id="c-field" value="delivery_context" required maxlength="120"></label><label class="field"><span>Proposed value</span><textarea id="c-value" required maxlength="8000"></textarea></label><div class="dialog-actions"><button type="button" data-cancel class="secondary-button">Cancel</button><button type="submit" class="primary-button">Create candidate</button></div></form>`);
            this.by("candidate-form").onsubmit = event => { event.preventDefault(); const target = this.by("c-target").value; const field = L2G.sanitizePlainText(this.by("c-field").value, 120); const value = L2G.sanitizePlainText(this.by("c-value").value, 8000); this.store.execute("Create engagement candidate", "candidate", "new", state => L2G.createCandidate(state.engagement, target, { [field]: value }, "manual-candidate", "synthetic-local")); this.closeDialog(); };
            this.by("candidate-form").querySelector("[data-cancel]").onclick = () => this.closeDialog();
        }
        candidateAction(id, action) {
            const candidate = this.store.document.state.engagement.candidates.find(item => item.candidate_id === id); if (!candidate) return;
            if (action === "reject") { const rationale = prompt("Rejection rationale", "Rejected after synthetic review."); if (rationale === null) return; this.store.execute("Reject engagement candidate", "candidate", id, state => L2G.decideCandidate(state.engagement, id, "reject", rationale)); return; }
            if (action === "supersede") { const value = prompt("Replacement proposed value", String(Object.values(candidate.proposed_fields)[0] ?? "")); if (value === null) return; const field = Object.keys(candidate.proposed_fields)[0] ?? "delivery_context"; this.store.execute("Supersede engagement candidate", "candidate", id, state => L2G.supersedeCandidate(state.engagement, id, { [field]: value }, "Superseded after review.")); return; }
            if (action === "modify") { const field = Object.keys(candidate.proposed_fields)[0] ?? "delivery_context"; const value = prompt(`Modified value for ${field}`, String(candidate.proposed_fields[field] ?? "")); if (value === null) return; this.store.execute("Modify and accept engagement candidate", "candidate", id, state => L2G.decideCandidate(state.engagement, id, "modify", "Accepted with modification.", { [field]: value })); return; }
            if (confirm("Accept this candidate and apply its proposed fields to Engagement authority?")) this.store.execute("Accept engagement candidate", "candidate", id, state => L2G.decideCandidate(state.engagement, id, "accept", "Accepted after review."));
        }
        deactivateParticipant(id) { const item = this.store.document.state.engagement.participants.find(entry => entry.participant_id === id); if (!item || !confirm(`Deactivate “${item.name}”?`)) return; this.store.execute(`Deactivate participant “${item.name}”`, "participant", id, state => { const record = state.engagement.participants.find(entry => entry.participant_id === id); if (record) { record.participation_state = "inactive"; record.updated_at = L2G.nowIso(); } }); }
        deactivateOrganization(id) { const item = this.store.document.state.engagement.organizations.find(entry => entry.organization_id === id); if (!item || !confirm(`Deactivate “${item.name}”?`)) return; this.store.execute(`Deactivate organization “${item.name}”`, "organization", id, state => { const record = state.engagement.organizations.find(entry => entry.organization_id === id); if (record) { record.status = "inactive"; record.updated_at = L2G.nowIso(); } }); }
        reviewAction(identifier, action) { this.store.execute(`${action === "approve" ? "Approve" : "Request changes for"} review example`, "review", identifier, state => { const item = state.reviews_actions.examples.find(entry => entry.id === identifier); if (!item) return; if (action === "approve") { item.lifecycle = "Approved"; item.review_state = "Approved"; item.operational_state = "Done"; } else { item.review_state = "Changes requested"; item.operational_state = "Waiting"; } }); }
        help() { this.dialog("Engagement Spine help", `<div class="prose"><h3>Engagement authority</h3><p>Pre-Engagement owns accepted engagement context. Other workspaces receive frozen read-only projections.</p><h3>Candidates</h3><p>Imported or proposed metadata does not change accepted state until an Advisor explicitly accepts or modifies it.</p><h3>Protection and limitations</h3><p>Portable saves and browser recovery are encrypted after a passphrase is created. Passphrases cannot be reset. Presentation profiles are not security roles. This release remains synthetic-only.</p><div class="dialog-actions"><button data-close class="primary-button">Close</button></div></div>`); this.by("dialog-content").querySelector("[data-close]").onclick = () => this.closeDialog(); }
        about() { const release = window.__L2G_RELEASE__; this.dialog("About L2G Integrated Suite", `<div class="prose"><dl><dt>Version</dt><dd>${L2G.escapeHtml(release.version)}</dd><dt>Engagement schema</dt><dd><code>l2g_engagement_v1</code></dd><dt>Envelope</dt><dd><code>l2g_encrypted_project_v1</code></dd><dt>Project</dt><dd><code>l2g_project_v1</code></dd><dt>Runtime</dt><dd>Single local HTML, no telemetry, no runtime network</dd><dt>Authorization</dt><dd>Synthetic-only; production/client/FCI/CUI use not authorized</dd></dl><div class="dialog-actions"><button data-close class="primary-button">Close</button></div></div>`); this.by("dialog-content").querySelector("[data-close]").onclick = () => this.closeDialog(); }
