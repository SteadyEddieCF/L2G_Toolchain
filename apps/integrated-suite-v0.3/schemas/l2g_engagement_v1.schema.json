{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l2g:schema:l2g_engagement_v1:1.0",
  "title": "L2G Engagement Spine v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind","schema_version","engagement_id","identity","participants","organizations","assumptions","decisions","open_questions","constraints","milestones","blockers","candidates","projection_policy"],
  "properties": {
    "schema_kind": {"const":"l2g_engagement_v1"},
    "schema_version": {"const":"1.0"},
    "engagement_id": {"type":"string","pattern":"^engagement_[A-Za-z0-9_-]+$","maxLength":160},
    "identity": {"$ref":"#/$defs/identity"},
    "participants": {"type":"array","maxItems":200,"items":{"$ref":"#/$defs/participant"}},
    "organizations": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/organization"}},
    "assumptions": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/assumption"}},
    "decisions": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/decision"}},
    "open_questions": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/question"}},
    "constraints": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/constraint"}},
    "milestones": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/milestone"}},
    "blockers": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/blocker"}},
    "candidates": {"type":"array","maxItems":250,"items":{"$ref":"#/$defs/candidate"}},
    "projection_policy": {"type":"object","additionalProperties":false,"required":["client_export_required","profiles_are_security_roles"],"properties":{"client_export_required":{"const":true},"profiles_are_security_roles":{"const":false}}}
  },
  "$defs": {
    "visibility": {"enum":["advisor-only","client-safe","approved-for-client-presentation"]},
    "date": {"anyOf":[{"const":""},{"type":"string","format":"date"}]},
    "timestamp": {"type":"string","format":"date-time"},
    "provenance": {"type":"object","additionalProperties":false,"required":["source_kind","source_id","source_label","source_location","asserted_at","asserted_by","confidence"],"properties":{"source_kind":{"type":"string","maxLength":120},"source_id":{"type":"string","maxLength":300},"source_label":{"type":"string","maxLength":300},"source_location":{"type":"string","maxLength":500},"asserted_at":{"$ref":"#/$defs/timestamp"},"asserted_by":{"enum":["advisor","client","reviewer"]},"confidence":{"enum":["not-evaluated","low","medium","high"]}}},
    "identity": {"type":"object","additionalProperties":false,"required":["engagement_name","client_name","system_name","delivery_context","objectives","target_level","phase","start_date","target_end_date","information_label","lifecycle","visibility","updated_at"],"properties":{"engagement_name":{"type":"string","maxLength":200},"client_name":{"type":"string","maxLength":200},"system_name":{"type":"string","maxLength":200},"delivery_context":{"type":"string","maxLength":200},"objectives":{"type":"string","maxLength":8000},"target_level":{"enum":["CMMC Level 2","CMMC Level 1","Other","Not specified"]},"phase":{"enum":["planning","discovery","scoping","practice-review","ssp-development","delivery","review","closed"]},"start_date":{"$ref":"#/$defs/date"},"target_end_date":{"$ref":"#/$defs/date"},"information_label":{"enum":["Synthetic","Public","Internal","FCI","CUI","Unknown"]},"lifecycle":{"const":"accepted"},"visibility":{"$ref":"#/$defs/visibility"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "organization": {"type":"object","additionalProperties":false,"required":["organization_id","name","relationship","status","visibility","provenance","created_at","updated_at"],"properties":{"organization_id":{"type":"string","pattern":"^organization_[A-Za-z0-9_-]+$"},"name":{"type":"string","maxLength":200},"relationship":{"enum":["client","advisor","MSP","CSP","provider","assessor","other"]},"status":{"enum":["active","inactive","superseded"]},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "participant": {"type":"object","additionalProperties":false,"required":["participant_id","name","role","organization_id","contact_reference","participation_state","visibility","provenance","created_at","updated_at"],"properties":{"participant_id":{"type":"string","pattern":"^participant_[A-Za-z0-9_-]+$"},"name":{"type":"string","maxLength":200},"role":{"type":"string","maxLength":200},"organization_id":{"type":"string","maxLength":160},"contact_reference":{"type":"string","maxLength":200},"participation_state":{"enum":["active","inactive","superseded"]},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "base": {"type":"object","properties":{"title":{"type":"string","maxLength":200},"detail":{"type":"string","maxLength":8000},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"related_refs":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":200}},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "assumption": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","additionalProperties":false,"required":["assumption_id","title","detail","state","visibility","provenance","related_refs","created_at","updated_at"],"properties":{"assumption_id":{"type":"string","pattern":"^assumption_[A-Za-z0-9_-]+$"},"title":{},"detail":{},"state":{"enum":["open","confirmed","rejected","superseded"]},"visibility":{},"provenance":{},"related_refs":{},"created_at":{},"updated_at":{}}}]},
    "decision": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","additionalProperties":false,"required":["decision_id","title","detail","state","rationale","visibility","provenance","related_refs","created_at","updated_at"],"properties":{"decision_id":{"type":"string","pattern":"^decision_[A-Za-z0-9_-]+$"},"title":{},"detail":{},"state":{"enum":["proposed","accepted","revised","superseded"]},"rationale":{"type":"string","maxLength":8000},"visibility":{},"provenance":{},"related_refs":{},"created_at":{},"updated_at":{}}}]},
    "question": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","additionalProperties":false,"required":["question_id","title","detail","state","answer","visibility","provenance","related_refs","created_at","updated_at"],"properties":{"question_id":{"type":"string","pattern":"^question_[A-Za-z0-9_-]+$"},"title":{},"detail":{},"state":{"enum":["open","answered","deferred","closed"]},"answer":{"type":"string","maxLength":8000},"visibility":{},"provenance":{},"related_refs":{},"created_at":{},"updated_at":{}}}]},
    "constraint": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","additionalProperties":false,"required":["constraint_id","title","detail","state","visibility","provenance","related_refs","created_at","updated_at"],"properties":{"constraint_id":{"type":"string","pattern":"^constraint_[A-Za-z0-9_-]+$"},"title":{},"detail":{},"state":{"enum":["active","resolved","superseded","archived"]},"visibility":{},"provenance":{},"related_refs":{},"created_at":{},"updated_at":{}}}]},
    "milestone": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","additionalProperties":false,"required":["milestone_id","title","detail","target_date","owner_label","workstream","operational_state","visibility","provenance","related_refs","created_at","updated_at"],"properties":{"milestone_id":{"type":"string","pattern":"^milestone_[A-Za-z0-9_-]+$"},"title":{},"detail":{},"target_date":{"$ref":"#/$defs/date"},"owner_label":{"type":"string","maxLength":200},"workstream":{"type":"string","maxLength":200},"operational_state":{"enum":["planned","in-progress","waiting","blocked","completed","cancelled"]},"visibility":{},"provenance":{},"related_refs":{},"created_at":{},"updated_at":{}}}]},
    "blocker": {"allOf":[{"$ref":"#/$defs/base"},{"type":"object","additionalProperties":false,"required":["blocker_id","title","detail","severity","operational_state","owner_label","visibility","provenance","related_refs","created_at","updated_at"],"properties":{"blocker_id":{"type":"string","pattern":"^blocker_[A-Za-z0-9_-]+$"},"title":{},"detail":{},"severity":{"enum":["low","medium","high","critical"]},"operational_state":{"enum":["open","waiting","resolved","cancelled"]},"owner_label":{"type":"string","maxLength":200},"visibility":{},"provenance":{},"related_refs":{},"created_at":{},"updated_at":{}}}]},
    "candidate": {"type":"object","additionalProperties":false,"required":["candidate_id","source_kind","source_reference","target_type","proposed_fields","state","rationale","decision_at","decision_by","accepted_record_ref","supersedes_candidate_id","superseded_by_candidate_id","original_proposed_fields","provenance","visibility","created_at"],"properties":{"candidate_id":{"type":"string","pattern":"^candidate_[A-Za-z0-9_-]+$"},"source_kind":{"type":"string","maxLength":120},"source_reference":{"type":"string","maxLength":300},"target_type":{"enum":["identity","participant","organization","assumption","decision","open-question","constraint","milestone","blocker"]},"proposed_fields":{"type":"object"},"state":{"enum":["candidate","accepted","modified","rejected","superseded"]},"rationale":{"type":"string","maxLength":8000},"decision_at":{"type":"string"},"decision_by":{"type":"string","maxLength":120},"accepted_record_ref":{"type":"string","maxLength":160},"supersedes_candidate_id":{"type":"string","maxLength":160},"superseded_by_candidate_id":{"type":"string","maxLength":160},"original_proposed_fields":{"type":"object"},"provenance":{"$ref":"#/$defs/provenance"},"visibility":{"$ref":"#/$defs/visibility"},"created_at":{"$ref":"#/$defs/timestamp"}}}
  }
}
