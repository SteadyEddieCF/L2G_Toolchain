{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2g.local/schemas/l2g_engagement_v1.schema.json",
  "title": "L2G Engagement Domain v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind","schema_version","engagement_id","identity","participants","organizations","assumptions","decisions","open_questions","constraints","milestones","blockers","candidates","projection_policy"],
  "$defs": {
    "visibility": {"enum": ["advisor-only","client-safe","approved-for-client-presentation"]},
    "id": {"type": "string","pattern": "^[A-Za-z][A-Za-z0-9_-]{1,127}$"},
    "timestamp": {"type": "string","format": "date-time"},
    "provenance": {
      "type": "object","additionalProperties": false,
      "required": ["source_kind","source_id","asserted_at","asserted_by","confidence"],
      "properties": {
        "source_kind": {"type":"string","maxLength":200},
        "source_id": {"type":"string","maxLength":200},
        "source_label": {"type":"string","maxLength":200},
        "source_location": {"type":"string","maxLength":500},
        "asserted_at": {"$ref":"#/$defs/timestamp"},
        "asserted_by": {"enum":["advisor","client","reviewer","migration","system"]},
        "confidence": {"enum":["not-evaluated","low","medium","high"]}
      }
    },
    "relatedBase": {
      "type":"object",
      "required":["title","detail","visibility","provenance","related_refs","created_at","updated_at"],
      "properties": {
        "title":{"type":"string","maxLength":200},
        "detail":{"type":"string","maxLength":8000},
        "visibility":{"$ref":"#/$defs/visibility"},
        "provenance":{"$ref":"#/$defs/provenance"},
        "related_refs":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "created_at":{"$ref":"#/$defs/timestamp"},
        "updated_at":{"$ref":"#/$defs/timestamp"}
      }
    }
  },
  "properties": {
    "schema_kind": {"const":"l2g_engagement_v1"},
    "schema_version": {"const":"1.0"},
    "engagement_id": {"type":"string","pattern":"^engagement_[A-Za-z0-9_-]+$","maxLength":128},
    "identity": {
      "type":"object","additionalProperties":false,
      "required":["engagement_name","client_name","system_name","delivery_context","objectives","target_level","phase","start_date","target_end_date","information_label","lifecycle","visibility","updated_at"],
      "properties": {
        "engagement_name":{"type":"string","maxLength":200},
        "client_name":{"type":"string","maxLength":200},
        "system_name":{"type":"string","maxLength":200},
        "delivery_context":{"type":"string","maxLength":8000},
        "objectives":{"type":"string","maxLength":8000},
        "target_level":{"enum":["CMMC Level 2","CMMC Level 1","Other","Not specified"]},
        "phase":{"enum":["planning","discovery","scoping","practice-review","ssp-development","delivery","review","closed"]},
        "start_date":{"type":"string","pattern":"^(|\\d{4}-\\d{2}-\\d{2})$"},
        "target_end_date":{"type":"string","pattern":"^(|\\d{4}-\\d{2}-\\d{2})$"},
        "information_label":{"enum":["Synthetic","Public","Internal","FCI","CUI","Unknown"]},
        "lifecycle":{"const":"accepted"},
        "visibility":{"$ref":"#/$defs/visibility"},
        "updated_at":{"$ref":"#/$defs/timestamp"}
      }
    },
    "participants":{"type":"array","maxItems":200,"items":{"type":"object"}},
    "organizations":{"type":"array","maxItems":100,"items":{"type":"object"}},
    "assumptions":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "decisions":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "open_questions":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "constraints":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "milestones":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "blockers":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "candidates":{"type":"array","maxItems":250,"items":{"type":"object"}},
    "projection_policy": {
      "type":"object","additionalProperties":false,
      "required":["client_visible_values","reviewer_include_provenance","client_include_candidates"],
      "properties": {
        "client_visible_values":{"const":["client-safe","approved-for-client-presentation"]},
        "reviewer_include_provenance":{"const":true},
        "client_include_candidates":{"const":false}
      }
    }
  }
}
