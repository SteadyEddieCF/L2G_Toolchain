{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "files": [
    "src/types.ts",
    "../integrated-suite-v0.2/src/util.ts",
    "../integrated-suite-v0.2/src/zip.ts",
    "src/engagement.ts",
    "src/evidence.ts",
    "src/project.ts",
    "../integrated-suite-v0.3/src/encryption.ts",
    "src/protection.ts",
    "src/recovery.ts",
    "src/hash-worker.ts",
    "src/app.ts"
  ]
}
