{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2g.local/schemas/l2g_evidence_index_v1.schema.json",
  "title": "L2G Evidence Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind","schema_version","catalog_id","sources","locations","derived_records","relationships","duplicate_groups","candidate_mappings","verification_receipts","import_receipts","projection_policy"],
  "properties": {
    "schema_kind": {"const":"l2g_evidence_index_v1"},
    "schema_version": {"const":"1.0"},
    "catalog_id": {"type":"string","pattern":"^evidence_catalog_[A-Za-z0-9_-]+$","maxLength":128},
    "sources": {"type":"array","maxItems":2000,"items":{"$ref":"#/$defs/source"}},
    "locations": {"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/location"}},
    "derived_records": {"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/derived"}},
    "relationships": {"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/relationship"}},
    "duplicate_groups": {"type":"array","maxItems":2000,"items":{"$ref":"#/$defs/duplicateGroup"}},
    "candidate_mappings": {"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/candidate"}},
    "verification_receipts": {"type":"array","maxItems":2000,"items":{"$ref":"#/$defs/verification"}},
    "import_receipts": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/importReceipt"}},
    "projection_policy": {
      "type":"object","additionalProperties":false,
      "required":["client_visible_values","client_requires_label","client_include_original_names","client_include_fingerprints","client_include_candidates","client_include_provenance","search_index_persistence"],
      "properties": {
        "client_visible_values":{"const":["client-safe","approved-for-client-presentation"]},
        "client_requires_label":{"const":true},"client_include_original_names":{"const":false},"client_include_fingerprints":{"const":false},"client_include_candidates":{"const":false},"client_include_provenance":{"const":false},"search_index_persistence":{"const":"none"}
      }
    }
  },
  "$defs": {
    "visibility":{"enum":["advisor-only","client-safe","approved-for-client-presentation"]},
    "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]+$","maxLength":128},
    "timestamp":{"type":"string","format":"date-time"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "provenance": {
      "type":"object","additionalProperties":false,
      "required":["source_kind","source_id","asserted_at","asserted_by","confidence"],
      "properties":{"source_kind":{"type":"string","maxLength":200},"source_id":{"type":"string","maxLength":200},"source_label":{"type":"string","maxLength":300},"source_location_ref":{"type":["string","null"],"maxLength":200},"asserted_at":{"$ref":"#/$defs/timestamp"},"asserted_by":{"enum":["advisor","client","reviewer","migration","system"]},"confidence":{"enum":["not-evaluated","low","medium","high"]}}
    },
    "source": {
      "type":"object","additionalProperties":false,
      "required":["evidence_id","display_label","client_label","original_name","collection_label","origin_kind","media_type","extension","size_bytes","last_modified_ms","fingerprint","lifecycle","processing_state","review_state","trust_state","visibility","tags","supersedes_source_ref","superseded_by_source_ref","duplicate_group_ref","provenance","created_at","updated_at"],
      "properties": {
        "evidence_id":{"type":"string","pattern":"^evidence_[A-Za-z0-9_-]+$","maxLength":128},"display_label":{"type":"string","minLength":1,"maxLength":300},"client_label":{"type":"string","maxLength":300},"original_name":{"type":"string","minLength":1,"maxLength":300},"collection_label":{"type":"string","maxLength":300},
        "origin_kind":{"enum":["local-file","legacy-package-record","generated-output-reference","external-reference"]},"media_type":{"type":"string","minLength":1,"maxLength":200},"extension":{"type":"string","maxLength":20},"size_bytes":{"type":"integer","minimum":0,"maximum":2147483648},"last_modified_ms":{"type":"integer","minimum":0},
        "fingerprint":{"oneOf":[{"type":"object","additionalProperties":false,"required":["algorithm","sha256"],"properties":{"algorithm":{"const":"SHA-256"},"sha256":{"$ref":"#/$defs/sha256"}}},{"type":"null"}]},
        "lifecycle":{"enum":["active","superseded","archived"]},"processing_state":{"enum":["not-requested","pending","processing","complete","partial","failed","unsupported"]},"review_state":{"enum":["unreviewed","in-review","reviewed","needs-attention","excluded"]},"trust_state":{"enum":["not-evaluated","no-exception","exception-open","exception-resolved","rejected"]},"visibility":{"$ref":"#/$defs/visibility"},
        "tags":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},"supersedes_source_ref":{"type":["string","null"],"maxLength":128},"superseded_by_source_ref":{"type":["string","null"],"maxLength":128},"duplicate_group_ref":{"type":["string","null"],"maxLength":128},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}
      }
    },
    "location": {
      "type":"object","additionalProperties":false,
      "required":["location_id","source_ref","kind","label","page_start","page_end","paragraph","sheet","row_start","row_end","column_start","column_end","slide_start","slide_end","object_label","speaker","start_ms","end_ms","package_path","record_path","visibility","provenance","created_at","updated_at"],
      "properties":{"location_id":{"type":"string","pattern":"^location_[A-Za-z0-9_-]+$"},"source_ref":{"type":"string","pattern":"^evidence_[A-Za-z0-9_-]+$"},"kind":{"enum":["whole-source","page","paragraph","sheet","row","cell-range","slide","object","speaker-turn","timestamp-range","package-field","unknown"]},"label":{"type":"string","minLength":1,"maxLength":300},"page_start":{"type":["integer","null"],"minimum":0},"page_end":{"type":["integer","null"],"minimum":0},"paragraph":{"type":["string","null"],"maxLength":300},"sheet":{"type":["string","null"],"maxLength":300},"row_start":{"type":["integer","null"],"minimum":0},"row_end":{"type":["integer","null"],"minimum":0},"column_start":{"type":["string","null"],"maxLength":20},"column_end":{"type":["string","null"],"maxLength":20},"slide_start":{"type":["integer","null"],"minimum":0},"slide_end":{"type":["integer","null"],"minimum":0},"object_label":{"type":["string","null"],"maxLength":300},"speaker":{"type":["string","null"],"maxLength":300},"start_ms":{"type":["integer","null"],"minimum":0},"end_ms":{"type":["integer","null"],"minimum":0},"package_path":{"type":["string","null"],"maxLength":500},"record_path":{"type":["string","null"],"maxLength":500},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}
    },
    "field":{"type":"object","additionalProperties":false,"required":["name","value_type","value"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100},"value_type":{"enum":["string","number","boolean","null"]},"value":{"type":["string","number","boolean","null"]}}},
    "derived":{"type":"object","additionalProperties":false,"required":["derived_id","source_ref","kind","title","summary","fields","location_refs","parser","confidence","review_state","visibility","provenance","created_at","updated_at"],"properties":{"derived_id":{"type":"string","pattern":"^derived_[A-Za-z0-9_-]+$"},"source_ref":{"type":"string","pattern":"^evidence_[A-Za-z0-9_-]+$"},"kind":{"enum":["extract-summary","structured-record","diagram-description","security-evidence-item","meeting-segment","parser-diagnostic"]},"title":{"type":"string","minLength":1,"maxLength":300},"summary":{"type":"string","maxLength":16000},"fields":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/field"}},"location_refs":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"type":"string","pattern":"^location_[A-Za-z0-9_-]+$"}},"parser":{"type":"object","additionalProperties":false,"required":["name","version","method"],"properties":{"name":{"type":"string","maxLength":200},"version":{"type":"string","maxLength":100},"method":{"type":"string","maxLength":200}}},"confidence":{"enum":["not-evaluated","low","medium","high"]},"review_state":{"enum":["unreviewed","in-review","reviewed","needs-attention","excluded"]},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "relationship":{"type":"object","additionalProperties":false,"required":["relationship_id","relationship_type","from_ref","to_ref","rationale","visibility","provenance","created_at"],"properties":{"relationship_id":{"type":"string","pattern":"^evidence_relationship_[A-Za-z0-9_-]+$"},"relationship_type":{"enum":["duplicate-of","revision-of","derived-from","contains","supports","related-to"]},"from_ref":{"$ref":"#/$defs/id"},"to_ref":{"$ref":"#/$defs/id"},"rationale":{"type":"string","maxLength":8000},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"}}},
    "duplicateGroup":{"type":"object","additionalProperties":false,"required":["duplicate_group_id","sha256","members","state","visibility","created_at","updated_at"],"properties":{"duplicate_group_id":{"type":"string","pattern":"^duplicate_group_[A-Za-z0-9_-]+$"},"sha256":{"$ref":"#/$defs/sha256"},"members":{"type":"array","minItems":2,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["source_ref","disposition","rationale"],"properties":{"source_ref":{"type":"string","pattern":"^evidence_[A-Za-z0-9_-]+$"},"disposition":{"enum":["unresolved","primary","duplicate","retained-distinct","excluded"]},"rationale":{"type":"string","maxLength":8000}}}},"state":{"enum":["unresolved","resolved"]},"visibility":{"$ref":"#/$defs/visibility"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["candidate_id","source_refs","location_refs","derived_refs","target_domain","target_type","proposed_operation","proposed_fields","state","rationale","target_candidate_ref","supersedes_candidate_ref","superseded_by_candidate_ref","visibility","provenance","created_at","updated_at"],"properties":{"candidate_id":{"type":"string","pattern":"^evidence_candidate_[A-Za-z0-9_-]+$"},"source_refs":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"string"}},"location_refs":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"type":"string"}},"derived_refs":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"type":"string"}},"target_domain":{"enum":["engagement","pre-engagement","scope","practice-review","ssp","deliverables","reviews-actions"]},"target_type":{"type":"string","minLength":1,"maxLength":120},"proposed_operation":{"enum":["create","update","link","request-review"]},"proposed_fields":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100},"value":{"type":"string","maxLength":8000}}}},"state":{"enum":["draft","awaiting-review","published-to-target","returned","withdrawn","superseded","closed"]},"rationale":{"type":"string","minLength":1,"maxLength":8000},"target_candidate_ref":{"type":["string","null"]},"supersedes_candidate_ref":{"type":["string","null"]},"superseded_by_candidate_ref":{"type":["string","null"]},"visibility":{"$ref":"#/$defs/visibility"},"provenance":{"$ref":"#/$defs/provenance"},"created_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"}}},
    "verification":{"type":"object","additionalProperties":false,"required":["verification_id","source_ref","operation","selected_name","selected_size_bytes","selected_last_modified_ms","selected_sha256","result","related_source_ref","rationale","performed_at","performed_by"],"properties":{"verification_id":{"type":"string","pattern":"^verification_[A-Za-z0-9_-]+$"},"source_ref":{"type":"string"},"operation":{"enum":["initial-registration","relink","revision-registration","duplicate-registration"]},"selected_name":{"type":"string","minLength":1,"maxLength":300},"selected_size_bytes":{"type":"integer","minimum":0,"maximum":2147483648},"selected_last_modified_ms":{"type":"integer","minimum":0},"selected_sha256":{"$ref":"#/$defs/sha256"},"result":{"enum":["exact-match","duplicate-existing","new-revision-created"]},"related_source_ref":{"type":["string","null"]},"rationale":{"type":"string","minLength":1,"maxLength":8000},"performed_at":{"$ref":"#/$defs/timestamp"},"performed_by":{"const":"advisor"}}},
    "importReceipt":{"type":"object","additionalProperties":false,"required":["import_id","package_kind","package_version","package_name","package_size_bytes","package_sha256","registry_version","source_document_ids","staged_source_refs","staged_location_refs","staged_derived_refs","staged_candidate_refs","warnings","state","imported_at","imported_by"],"properties":{"import_id":{"type":"string","pattern":"^evidence_import_[A-Za-z0-9_-]+$"},"package_kind":{"enum":["l2g_intake_package_v1","l2g_scope_context_v1","l2g_meeting_context_v1"]},"package_version":{"const":"1.0"},"package_name":{"type":"string","minLength":1,"maxLength":300},"package_size_bytes":{"type":"integer","minimum":1,"maximum":4194304},"package_sha256":{"$ref":"#/$defs/sha256"},"registry_version":{"type":"string","minLength":1,"maxLength":100},"source_document_ids":{"type":"array","maxItems":500,"items":{"type":"string"}},"staged_source_refs":{"type":"array","maxItems":500,"items":{"type":"string"}},"staged_location_refs":{"type":"array","maxItems":500,"items":{"type":"string"}},"staged_derived_refs":{"type":"array","maxItems":500,"items":{"type":"string"}},"staged_candidate_refs":{"type":"array","maxItems":500,"items":{"type":"string"}},"warnings":{"type":"array","maxItems":500,"items":{"type":"string","maxLength":8000}},"state":{"enum":["previewed","applied","partial","rejected","superseded"]},"imported_at":{"$ref":"#/$defs/timestamp"},"imported_by":{"const":"advisor"}}}
  }
}
