        "rationale": {"type": "string", "minLength": 1, "maxLength": 8000}, "state": {"enum": ["draft", "awaiting-review", "published-to-target", "returned", "withdrawn", "superseded", "closed"]}, "target_candidate_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/typedId"}]}, "target_decision_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/typedId"}]}, "visibility": {"$ref": "#/$defs/visibility"}, "supersedes_candidate_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidateId"}]}, "superseded_by_candidate_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidateId"}]}, "provenance": {"$ref": "#/$defs/provenance"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
